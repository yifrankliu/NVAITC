within ORNLSupercomputing.Components.Icons;
partial model CTWLoop

  annotation (defaultComponentName="CT_Loop", Icon(
                                               graphics={Bitmap(extent={{-100,-100},{100,100}}, fileName
            = "modelica://TRANSFORM/Resources/Images/Icons/subSystem.jpg"),
            Bitmap(extent={{-80,-80},{80,80}}, fileName=
              "modelica://ORNLSupercomputing/Resources/Images/CTW_Loop_Frontier.png"),
              Text(
          extent={{-90,-60},{90,-85}},
          lineColor={0,0,0},
          lineThickness=1,
          fillColor={255,255,237},
          fillPattern=FillPattern.Solid,
          textString="CTW Loop")}));
end CTWLoop;
