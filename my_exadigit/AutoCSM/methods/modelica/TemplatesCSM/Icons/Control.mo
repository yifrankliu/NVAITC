          Rectangle(
          extent={{-100,100},{100,-100}},
          fillColor={244,167,131},
          fillPattern=FillPattern.Solid,
          lineColor={0,0,0},
          lineThickness=0.5)}), Diagram(coordinateSystem(
          preserveAspectRatio=false)));
end Control;
